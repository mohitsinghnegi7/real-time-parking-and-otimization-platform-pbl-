<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- Handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#D5D8DE" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Add Vehicle"
        android:textColor="#171A21"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Add a vehicle to your account"
        android:textColor="#7A7F8C"
        android:textSize="13sp" />

    <!-- Vehicle Number Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="Vehicle Number"
        android:textColor="#30343B"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Vehicle Number -->
    <EditText
        android:id="@+id/etVehicleNumber"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="#F3F4F7"
        android:hint="e.g. UK07AB1234"
        android:inputType="textCapCharacters"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#171A21"
        android:textColorHint="#9A9FAA"
        android:textSize="14sp" />

    <!-- Vehicle Type Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Vehicle Type"
        android:textColor="#30343B"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Vehicle Type Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Four Wheeler -->
        <TextView
            android:id="@+id/optionFourWheeler"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="#171A21"
            android:gravity="center"
            android:text="🚗  Four Wheeler"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- Two Wheeler -->
        <TextView
            android:id="@+id/optionTwoWheeler"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="#F1F3F6"
            android:gravity="center"
            android:text="🛵  Two Wheeler"
            android:textColor="#5E6470"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Add Button -->
    <TextView
        android:id="@+id/btnSubmitVehicle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="#171A21"
        android:gravity="center"
        android:text="Add Vehicle"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>