<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F6FA">

    <TextView
        android:id="@+id/tvSlotTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Parking Slot Management"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#172033"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvSelectedLot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selected parking lot"
        android:textSize="15sp"
        android:textColor="#64748B"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/progressSlots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvEmptySlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No parking slots found."
        android:gravity="center"
        android:padding="24dp"
        android:textSize="15sp"
        android:textColor="#64748B"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

</LinearLayout>